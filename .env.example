# ─────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (packages/database)
DATABASE_URL="postgresql://mastershopee:mastershopee@localhost:5432/mastershopee?schema=public"

# Redis (queues, cache, rate limiting) — apps/worker, apps/web
REDIS_URL="redis://localhost:6379"

# Auth (NextAuth / Auth.js) — apps/web
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL, not AUTH_URL: next-auth v4 reads only this name (AUTH_URL is
# the v5/Auth.js convention and is silently ignored here). It must match the
# origin the browser actually uses — including the scheme, since next-auth
# decides whether to issue a Secure session cookie from
# `NEXTAUTH_URL.startsWith("https://")`. Point it at your tunnel URL when
# testing through ngrok, and at the deployed domain in production, or login
# fails CSRF validation with a misleading "wrong password" error.
NEXTAUTH_URL="http://localhost:3000"

# Field-level encryption key for marketplace credentials (32-byte, base64)
# generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="generate-a-real-32-byte-base64-key"

# Transactional e-mail (verification, password reset) — provider of your choice
EMAIL_FROM="Mastershopee <no-reply@mastershopee.app>"
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# ─────────────────────────────────────────────────────────────
# BILLING — Stripe (recommended: official recurring billing + webhooks)
# PENDING: create a Stripe account and products/prices for STARTER/PRO/SCALE
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=

# ─────────────────────────────────────────────────────────────
# MARKETPLACE INTEGRATIONS
# All of these require a registered developer application approved by
# the marketplace. See packages/integrations/README.md for the exact
# OAuth flow, scopes and known limitations of each provider.
# ─────────────────────────────────────────────────────────────

# Shopee Open Platform — https://open.shopee.com
# PENDING: partner registration + app approval
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL="http://localhost:3000/api/integrations/shopee/callback"
# "test" while your app is still in Shopee's Test/Sandbox tier (before Live
# approval) — using the Test partner_id against the Live API fails with
# "invalid_partner_id". Switch to "live" once Shopee approves the app.
SHOPEE_ENV=test
# Como ler o partner_key que o console da Shopee mostra. O console imprime a
# chave como `shpk` + hexadecimal e a documentação não diz se essa string é a
# chave do HMAC ou só o formato de exibição — assinar com a leitura errada dá
# "error_sign". Rode POST /api/integrations/shopee/diagnose: ele pergunta à
# Shopee qual leitura ela aceita e responde qual valor pôr aqui.
#   raw         = assina com a string exibida, `shpk` incluso (padrão)
#   stripped    = assina sem o prefixo `shpk`
#   hex-decoded = decodifica o hexadecimal depois do `shpk` e assina com os bytes
SHOPEE_KEY_ENCODING=raw

# Mercado Livre Developers — https://developers.mercadolivre.com.br
# PENDING: create application in DevCenter to obtain App ID / Secret
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI="http://localhost:3000/api/integrations/mercadolivre/callback"

# SHEIN Open Platform (Seller API)
# PENDING: SHEIN seller/partner approval — no public self-serve signup as of writing
SHEIN_APP_ID=
SHEIN_APP_SECRET=
SHEIN_REDIRECT_URI="http://localhost:3000/api/integrations/shein/callback"

# TikTok Shop Partner Center — https://partner.tiktokshop.com
# PENDING: partner app registration + approval
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_REDIRECT_URI="http://localhost:3000/api/integrations/tiktokshop/callback"

# ─────────────────────────────────────────────────────────────
# WHATSAPP — WhatsApp Business Platform (Cloud API via Meta)
# PENDING: Meta Business verification, phone number, approved message templates
# ─────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Approved template names. Every message this app sends is business-initiated
# (a 7:30am report, a stock warning), and Meta only accepts free-form text
# inside the 24h window the recipient opens — outside it, a template is the
# only thing that gets delivered. See docs/whatsapp/setup.md for the exact
# body text to submit for approval.
WHATSAPP_TEMPLATE_DAILY_REPORT=mastershopee_daily_report
WHATSAPP_TEMPLATE_LOW_STOCK=mastershopee_low_stock
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Only set to point at a stub or an outbound proxy; defaults to Meta's Graph API.
# WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# ─────────────────────────────────────────────────────────────
# OBSERVABILITY (optional but recommended for production)
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
